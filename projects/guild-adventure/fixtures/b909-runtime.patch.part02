meSkillAcquisitionRuntime?GKGameSkillAcquisitionRuntime.previewAcquirePassive(c,passive,progression,passiveAcquisitionPolicy(c)):{ok:false,reason:owned?'PASSIVE_ALREADY_OWNED':progressionError||'ACQUISITION_RUNTIME_UNAVAILABLE'},cost=progression&&window.GKGameSkillAcquisitionRuntime?GKGameSkillAcquisitionRuntime.acquisitionCost(passive,'passive',progression):null,respec=owned&&progression&&window.GKGameSkillRespecRuntime?GKGameSkillRespecRuntime.previewIndividual(data,c,'passive',passive.id,progression,{validateAfterRemoval:validateCharacterAfterPassiveRemoval}):{ok:false,reason:'PASSIVE_NOT_OWNED'};return `<div class="skill-choice ${owned?'selected':''}"><div><b>${escapeHtml(passive.name)}</b><span class="tag">${escapeHtml(passive.id)}</span><span class="tag">${owned?(active?'有効':'条件未成立'):'未習得'}</span><div class="small">常時効果: ${escapeHtml(passiveEffectText(passive))}</div><div class="small">習得条件: ${escapeHtml(skillProgressionRequirementText(passive,'passive'))}</div><div class="small">必要Skill Point: ${cost??'—'}</div>${owned?`<div class="small">Respec: ${respec.ok?`${respec.cost} G / ${respec.skillPointsRefund} SP返還`:escapeHtml(skillProgressionFailureText(respec))}</div>`:`<div class="small">${preview.ok?'習得可能':escapeHtml(skillProgressionFailureText(preview))}</div>`}</div>${owned?`<button type="button" data-respec-passive="${escapeHtml(passive.id)}" ${respec.ok?'':'disabled'}>Respec</button>`:`<button type="button" class="primary" data-acquire-passive="${escapeHtml(passive.id)}" ${preview.ok?'':'disabled'}>習得する</button>`}</div>`}).join(''):`<div class="skill-empty">正式Passive Masterがありません。${passiveStateError?` ${escapeHtml(passiveStateError)}`:''}</div>`;passiveList.querySelectorAll('[data-acquire-passive]').forEach(btn=>btn.onclick=()=>{if(!progression||!window.GKGameSkillAcquisitionRuntime)return;const passive=formalPassiveCatalog.get(btn.dataset.acquirePassive),result=GKGameSkillAcquisitionRuntime.acquirePassive(c,passive,progression,passiveAcquisitionPolicy(c));if(!result.ok){notify(skillProgressionFailureText(result),'bad');return}autoSave();render();notify(`${passive.name}を習得しました。Skill Point -${result.skillPointsSpent}。`,'ok')});passiveList.querySelectorAll('[data-respec-passive]').forEach(btn=>btn.onclick=()=>{if(!progression||!window.GKGameSkillRespecRuntime)return;const id=btn.dataset.respecPassive,preview=GKGameSkillRespecRuntime.previewIndividual(data,c,'passive',id,progression,{validateAfterRemoval:validateCharacterAfterPassiveRemoval});if(!preview.ok){notify(skillProgressionFailureText(preview),'bad');return}if(!confirm(`PassiveをRespecします。${preview.cost} Gを消費し、${preview.skillPointsRefund} SPを返還します。消費したGoldは戻りません。`))return;const result=GKGameSkillRespecRuntime.respecIndividual(data,c,'passive',id,progression,{validateAfterRemoval:validateCharacterAfterPassiveRemoval});if(!result.ok){notify(skillProgressionFailureText(result),'bad');return}autoSave();render();notify(`PassiveをRespecしました。Skill Point +${result.skillPointsRefund} / ${result.cost} G消費。`,'ok')})}
  if(respecAllPanel){const preview=progression&&window.GKGameSkillRespecRuntime?GKGameSkillRespecRuntime.previewAll(data,c,progression,{validateAfterRemoval:validateCharacterAfterPassiveRemoval}):{ok:false,reason:progressionError||'RESPEC_RUNTIME_UNAVAILABLE'};respecAllPanel.innerHTML=`<b>全Respec</b><div class="small">${preview.ok?`${preview.cost} Gを消費 / ${preview.skillPointsRefund} SP返還。消費したGoldは戻りません。`:escapeHtml(skillProgressionFailureText(preview))}</div><button type="button" id="characterRespecAll" ${preview.ok?'':'disabled'}>Skill / Passiveを全Respec</button>`;const btn=$('characterRespecAll');if(btn)btn.onclick=()=>{const check=GKGameSkillRespecRuntime.previewAll(data,c,progression,{validateAfterRemoval:validateCharacterAfterPassiveRemoval});if(!check.ok){notify(skillProgressionFailureText(check),'bad');return}if(!confirm(`Skill / Passiveを全Respecします。${check.cost} Gを消費し、${check.skillPointsRefund} SPを返還します。消費したGoldは戻りません。`))return;const result=GKGameSkillRespecRuntime.respecAll(data,c,progression,{validateAfterRemoval:validateCharacterAfterPassiveRemoval});if(!result.ok){notify(skillProgressionFailureText(result),'bad');return}autoSave();render();notify(`全Respecしました。Skill Point +${result.skillPointsRefund} / ${result.cost} G消費。`,'ok')}}
  if(catalog){const candidates=productionSkills.filter(skill=>!c.skills.includes(skill.id));catalog.innerHTML=candidates.length?`<div class="small">開発者用の直接割当です。Player習得は上のSkill Point経路を使用します。</div>${candidates.map(skill=>`<button type="button" class="unit" data-assign-formal-skill="${skill.id}"><b>${escapeHtml(skill.name)}</b><span class="tag">${escapeHtml(skill.id)}</span><div class="small">この冒険者へ直接割当</div></button>`).join('')}`:'<div class="small">未割当の正式Production Skillはありません。</div>';catalog.querySelectorAll('[data-assign-formal-skill]').forEach(btn=>btn.onclick=()=>{const skill=findSkill(btn.dataset.assignFormalSkill),result=window.GKGameSkillLoadout?GKGameSkillLoadout.assignFormalProductionSkill(c,skill,compileSkillForRuntime):{ok:false,reason:'LOADOUT_RUNTIME_UNAVAILABLE'};if(!result.ok){notify(`正式Skillを割当できません: ${result.reason}`,'bad');return}autoSave();render();notify(`${c.name}へ${skill.name}を開発者割当しました。`)})}
 }
