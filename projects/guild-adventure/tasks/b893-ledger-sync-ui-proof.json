{
  "schemaVersion": 1,
  "name": "B893 development ledger sync UI proof",
  "outputDir": "artifacts",
  "viewport": { "width": 1440, "height": 1700 },
  "dialogPolicy": "accept",
  "steps": [
    { "action": "goto", "url": "https://kj2whvbzjn-hue.github.io/guild-adventure-studio/studio/?appv=893", "waitUntil": "networkidle", "timeout": 60000, "label": "open-b893" },
    { "action": "waitForText", "text": "Studio GKS-B893", "timeout": 20000, "label": "confirm-b893" },
    { "action": "clickText", "text": "開発管理を開く", "exact": true, "timeout": 15000, "label": "open-development" },
    { "action": "wait", "ms": 3000, "label": "wait-project-index" },
    { "action": "clickSelector", "selector": "button.dev-phonebook-row:has-text(\"Player AI パーツTag基盤・段階接続\")", "timeout": 30000, "label": "open-aitag" },
    { "action": "wait", "ms": 800 },
    { "action": "clickRole", "role": "button", "name": "構成・作業", "exact": true, "timeout": 15000 },
    { "action": "clickSelector", "selector": "[data-dax-action=\"select-node\"][data-id=\"ARCH-AITAG-STATE\"]", "timeout": 15000 },
    { "action": "clickSelector", "selector": "[data-dax-action=\"select-box\"][data-id=\"BOX-AITAG-003\"]", "timeout": 15000 },
    { "action": "clickSelector", "selector": "[data-dax-action=\"select-task\"][data-id=\"TASK-AITAG-029\"]", "timeout": 15000 },
    { "action": "assertText", "text": "Todo", "label": "aitag-old-todo" },
    { "action": "clickSelector", "selector": "[data-dax-action=\"edit-current-task\"]", "timeout": 10000 },
    { "action": "assertValueSelector", "selector": "#daxTaskApprovalStatus", "value": "Pending", "label": "aitag-approval-pending" },
    { "action": "selectSelector", "selector": "#daxTaskStatus", "value": "Doing", "label": "aitag-to-doing" },
    { "action": "clickSelector", "selector": "[data-dax-action=\"save-task\"]", "timeout": 10000 },
    { "action": "assertText", "text": "Doing", "label": "aitag-doing-visible" },
    { "action": "assertText", "text": "人間承認: Pending", "label": "aitag-approval-preserved" },
    { "action": "assertText", "text": "未保存", "label": "aitag-dirty" },
    { "action": "screenshot", "name": "aitag-029-doing-pending-ui" },

    { "action": "goto", "url": "https://kj2whvbzjn-hue.github.io/guild-adventure-studio/studio/?appv=893", "waitUntil": "networkidle", "timeout": 60000, "label": "fresh-b893-for-lbrc" },
    { "action": "clickText", "text": "開発管理を開く", "exact": true, "timeout": 15000 },
    { "action": "wait", "ms": 3000, "label": "wait-project-index-lbrc" },
    { "action": "clickSelector", "selector": "button.dev-phonebook-row:has-text(\"V9 Legacy Battle Runtime削除・正規戦闘値経路統一\")", "timeout": 30000, "label": "open-lbrc" },
    { "action": "wait", "ms": 800 },
    { "action": "clickRole", "role": "button", "name": "構成・作業", "exact": true, "timeout": 15000 },
    { "action": "clickSelector", "selector": "[data-dax-action=\"select-node\"][data-id=\"ARCH-LBRC-004\"]", "timeout": 15000 },
    { "action": "clickSelector", "selector": "[data-dax-action=\"select-box\"][data-id=\"BOX-LBRC-004\"]", "timeout": 15000 },
    { "action": "clickSelector", "selector": "[data-dax-action=\"select-task\"][data-id=\"TASK-LBRC-008A\"]", "timeout": 15000 },
    { "action": "assertText", "text": "Doing", "label": "lbrc-old-doing" },
    { "action": "clickSelector", "selector": "[data-dax-action=\"edit-current-task\"]", "timeout": 10000 },
    { "action": "assertValueSelector", "selector": "#daxTaskApprovalStatus", "value": "Approved", "label": "lbrc-approved" },
    { "action": "selectSelector", "selector": "#daxTaskStatus", "value": "Done", "label": "lbrc-to-done" },
    { "action": "clickSelector", "selector": "[data-dax-action=\"save-task\"]", "timeout": 10000 },
    { "action": "assertText", "text": "Done", "label": "lbrc-done-visible" },
    { "action": "assertText", "text": "人間承認: Approved", "label": "lbrc-approval-preserved" },
    { "action": "assertText", "text": "未保存", "label": "lbrc-dirty" },
    { "action": "dumpPage", "name": "lbrc-008a-done-ui" },
    { "action": "screenshot", "name": "lbrc-008a-done-approved-ui" }
  ]
}
