{
  "schemaVersion": 1,
  "name": "REORG R31 QST-0003 freeze/save-loss recovery public Game E2E B896",
  "outputDir": "artifacts",
  "viewport": { "width": 390, "height": 844 },
  "dialogPolicy": "accept",
  "steps": [
    { "action": "goto", "url": "https://kj2whvbzjn-hue.github.io/guild-adventure-studio/game/", "waitUntil": "networkidle", "timeout": 60000, "label": "open-public-game" },
    { "action": "waitForSelector", "selector": "#phase-title.active", "timeout": 20000, "label": "title-ready" },
    { "action": "assertText", "text": "GA-B486.227", "exact": false, "label": "public-build-b486-227" },
    { "action": "clickSelector", "selector": "#titleStart", "timeout": 20000, "label": "new-game" },
    { "action": "waitForSelector", "selector": "#phase-base.active", "timeout": 30000, "label": "new-game-reaches-base" },
    { "action": "dumpStorage", "name": "qst0003-after-new-game" },
    { "action": "screenshot", "name": "qst0003-after-new-game" },

    { "action": "clickSelector", "selector": "#baseMobileNav [data-base-tab=\"quest\"]", "timeout": 15000, "label": "open-quest-tab" },
    { "action": "waitForSelector", "selector": "#questList input[name=\"quest\"][value=\"QST-0003\"]", "timeout": 30000, "label": "qst0003-ready" },
    { "action": "checkSelector", "selector": "#questList input[name=\"quest\"][value=\"QST-0003\"]", "timeout": 15000, "label": "select-qst0003" },
    { "action": "dumpStorage", "name": "qst0003-selected" },
    { "action": "clickSelector", "selector": "#baseDepart", "timeout": 60000, "label": "start-qst0003" },
    { "action": "waitForSelector", "selector": "#phase-event.active", "timeout": 60000, "label": "qst0003-event-phase-reached" },
    { "action": "assertText", "text": "実機検証2：Budget必敗戦闘＋失敗後停止", "exact": true, "label": "qst0003-title" },
    { "action": "dumpStorage", "name": "qst0003-started" },
    { "action": "dumpPage", "name": "qst0003-started-page" },
    { "action": "screenshot", "name": "qst0003-started" },

    { "action": "wait", "ms": 35000, "label": "wait-qst0003-playback-complete" },
    { "action": "waitForText", "text": "冒険は失敗しました。帰還すると今回の報酬は反映されません。", "exact": true, "timeout": 20000, "label": "failure-playback-complete" },
    { "action": "dumpStorage", "name": "qst0003-complete-before-return" },
    { "action": "clickSelector", "selector": "#adventureReturn", "timeout": 20000, "label": "commit-failed-adventure-return" },
    { "action": "waitForSelector", "selector": "#adventureReturnResult:not(.hidden)", "timeout": 20000, "label": "return-result-visible" },
    { "action": "assertText", "text": "冒険失敗", "exact": false, "label": "failed-adventure-result" },
    { "action": "dumpStorage", "name": "qst0003-after-return-commit" },
    { "action": "screenshot", "name": "qst0003-after-return-commit" },
    { "action": "clickSelector", "selector": "#adventureReturnHome", "timeout": 15000, "label": "return-home" },
    { "action": "waitForSelector", "selector": "#phase-base.active", "timeout": 20000, "label": "base-after-failed-adventure" },

    { "action": "clickSelector", "selector": "#baseMobileNav [data-base-tab=\"adventurer\"]", "timeout": 15000, "label": "open-adventurer-tab" },
    { "action": "waitForText", "text": "冒険者名簿", "exact": true, "timeout": 15000, "label": "roster-panel-visible" },
    { "action": "assertText", "text": "アルト", "exact": true, "label": "starter-roster-still-present" },
    { "action": "dumpPage", "name": "qst0003-roster-after-failure" },
    { "action": "dumpStorage", "name": "qst0003-roster-after-failure" },
    { "action": "screenshot", "name": "qst0003-roster-after-failure" },

    { "action": "clickSelector", "selector": "#baseMobileNav [data-base-tab=\"guild\"]", "timeout": 15000, "label": "open-guild-tab" },
    { "action": "waitForSelector", "selector": "#guildToTitle", "timeout": 15000, "label": "guild-title-button-ready" },
    { "action": "clickSelector", "selector": "#guildToTitle", "timeout": 15000, "label": "return-title" },
    { "action": "waitForSelector", "selector": "#phase-title.active", "timeout": 15000, "label": "title-returned" },
    { "action": "waitForSelector", "selector": "#titleRestoreBackup:not([hidden])", "timeout": 15000, "label": "backup-recovery-visible" },
    { "action": "assertText", "text": "バックアップから復旧（6名）", "exact": true, "label": "backup-has-six-characters" },
    { "action": "screenshot", "name": "qst0003-backup-recovery-title" },
    { "action": "clickSelector", "selector": "#titleRestoreBackup", "timeout": 20000, "label": "restore-backup" },
    { "action": "waitForSelector", "selector": "#phase-base.active", "timeout": 30000, "label": "backup-restore-reaches-base" },
    { "action": "assertText", "text": "直前バックアップからセーブデータを復旧しました。", "exact": true, "label": "backup-restore-success-notice" },
    { "action": "dumpStorage", "name": "qst0003-after-backup-restore" },
    { "action": "dumpPage", "name": "qst0003-after-backup-restore-page" },
    { "action": "screenshot", "name": "qst0003-after-backup-restore" }
  ]
}
