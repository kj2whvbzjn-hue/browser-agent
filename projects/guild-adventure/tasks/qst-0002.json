      "expectedCount": 1
    },
    {
      "label": "qst-0002-formal-monster-proof-fix",
      "url": "**/guild-adventure-studio/Export/monster/monsters.json*",
      "search": "\"updated_at\": \"2026-09-07T05:42:02.255Z\"\n    },\n    {\n      \"id\": \"MON-0002\",",
      "replace": "\"updated_at\": \"2026-09-07T05:42:02.255Z\",\n      \"job_code\": \"MONSTER\",\n      \"level\": 1,\n      \"maxMp\": 0,\n      \"default_formation_position\": \"FRONTLINE\",\n      \"formalAiBinding\": {\n        \"program_id\": \"AIP-0001\",\n        \"layout_id\": \"AIL-0001\"\n      }\n    },\n    {\n      \"id\": \"MON-0002\",\n      \"job_code\": \"MONSTER\",\n      \"level\": 1,\n      \"maxMp\": 0,",
      "expectedCount": 1
    }
  ],
  "steps": [
