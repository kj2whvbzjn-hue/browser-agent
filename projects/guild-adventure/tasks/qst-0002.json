    { "action": "dumpPage", "name": "formal-monster-reward-result-page" },
    { "action": "dumpStorage", "name": "formal-monster-reward-result-storage" },
    { "action": "screenshot", "name": "formal-monster-reward-result" },

    { "action": "waitForSelector", "selector": "#adventureReturnHome", "label": "wait-return-home", "timeout": 10000 },
    { "action": "clickSelector", "selector": "#adventureReturnHome", "label": "return-to-base" },
    { "action": "wait", "ms": 1000, "label": "settle-base" },
    { "action": "dumpPage", "name": "formal-monster-final-base-page" },
