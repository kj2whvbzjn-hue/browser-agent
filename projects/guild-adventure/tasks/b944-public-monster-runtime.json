{
  "schemaVersion": 1,
  "name": "B944 public monster runtime E2E",
  "outputDir": "artifacts",
  "viewport": { "width": 390, "height": 844 },
  "dialogPolicy": "accept",
  "steps": [
    { "action": "goto", "url": "https://kj2whvbzjn-hue.github.io/guild-adventure-studio/game/", "waitUntil": "networkidle", "timeout": 60000, "label": "open-public-game" },
    { "action": "waitForSelector", "selector": "#phase-title.active", "timeout": 20000, "label": "title-ready" },
    { "action": "assertText", "text": "GA-B486.275", "exact": false, "label": "public-build-b944" },
    { "action": "clickSelector", "selector": "#titleStart", "timeout": 20000, "label": "new-game" },
    { "action": "waitForSelector", "selector": "#phase-base.active", "timeout": 30000, "label": "base-ready" },
    { "action": "clickSelector", "selector": "#baseMobileNav [data-base-tab=\"adventurer\"]", "timeout": 15000, "label": "open-adventurer" },
    { "action": "waitForSelector", "selector": "#roster .adventurer-row:has-text(\"アルト\")", "timeout": 20000, "label": "alto-ready" },
    { "action": "clickSelector", "selector": "#roster .adventurer-row:has-text(\"アルト\")", "timeout": 15000, "label": "select-alto" },
    { "action": "assertText", "text": "木の大剣", "exact": false, "label": "starter-weapon-visible" },
    { "action": "dumpStorage", "name": "b944-public-monster" },
    { "action": "dumpPage", "name": "b944-public-monster-page" },
    { "action": "screenshot", "name": "b944-public-monster" }
  ]
}
