{
  "schemaVersion": 1,
  "name": "B931 public no-patch Skill/Passive/Respec E2E",
  "outputDir": "artifacts",
  "viewport": { "width": 390, "height": 844 },
  "dialogPolicy": "accept",
  "steps": [
    { "action": "goto", "url": "https://kj2whvbzjn-hue.github.io/guild-adventure-studio/game/", "waitUntil": "networkidle", "timeout": 60000, "label": "open-public-game" },
    { "action": "waitForSelector", "selector": "#phase-title.active", "timeout": 20000, "label": "title-ready" },
    { "action": "assertText", "text": "GA-B486.262", "exact": false, "label": "public-build-b486-262" },
    { "action": "clickSelector", "selector": "#titleStart", "timeout": 20000, "label": "new-game" },
    { "action": "waitForSelector", "selector": "#phase-base.active", "timeout": 30000, "label": "new-game-reaches-base" },
    { "action": "clickSelector", "selector": "#baseMobileNav [data-base-tab=\"adventurer\"]", "timeout": 15000, "label": "open-adventurer-tab" },
    { "action": "waitForSelector", "selector": "#roster .adventurer-row:has-text(\"アルト\")", "timeout": 20000, "label": "alto-row-ready" },
    { "action": "clickSelector", "selector": "#roster .adventurer-row:has-text(\"アルト\")", "timeout": 15000, "label": "select-alto" },
    { "action": "waitForSelector", "selector": "#levelBtn", "timeout": 15000, "label": "alto-detail-ready" },
    { "action": "clickSelector", "selector": "#levelBtn", "timeout": 15000, "label": "level-up-for-skill-point" },
    { "action": "waitForText", "text": "Skill Point +1", "exact": false, "timeout": 15000, "label": "skill-point-granted" },
    { "action": "clickSelector", "selector": "#openSkillPlaceholder", "timeout": 15000, "label": "open-skill-passive-view" },
    { "action": "waitForText", "text": "アルトのSkill / Passive", "exact": true, "timeout": 15000, "label": "skill-passive-view-ready" },
    { "action": "waitForSelector", "selector": "#characterSkillPointSummary [data-skill-points]:has-text(\"1\")", "timeout": 15000, "label": "skill-point-balance-one" },
    { "action": "assertText", "text": "習得可能Skill", "exact": true, "label": "generated-active-skills-visible" },
    { "action": "assertText", "text": "能力値不足", "exact": false, "label": "active-skill-requirements-enforced" },
    { "action": "assertText", "text": "二刀流", "exact": true, "label": "passive-visible" },
    { "action": "waitForSelector", "selector": "[data-acquire-passive=\"PAS-0001\"]", "timeout": 15000, "label": "passive-acquire-ready" },
    { "action": "clickSelector", "selector": "[data-acquire-passive=\"PAS-0001\"]", "timeout": 15000, "label": "acquire-passive" },
    { "action": "waitForSelector", "selector": "#characterSkillPointSummary [data-skill-points]:has-text(\"0\")", "timeout": 15000, "label": "skill-point-spent" },
    { "action": "waitForSelector", "selector": "[data-select-passive=\"PAS-0001\"][data-selected=\"0\"]", "timeout": 15000, "label": "passive-learned-not-selected" },
    { "action": "clickSelector", "selector": "[data-select-passive=\"PAS-0001\"]", "timeout": 15000, "label": "select-passive-for-battle" },
    { "action": "waitForSelector", "selector": "[data-select-passive=\"PAS-0001\"][data-selected=\"1\"]", "timeout": 15000, "label": "passive-selected" },
    { "action": "assertText", "text": "選択中・有効", "exact": true, "label": "passive-effective" },
    { "action": "clickSelector", "selector": "[data-respec-passive=\"PAS-0001\"]", "timeout": 15000, "label": "individual-respec" },
    { "action": "waitForSelector", "selector": "#characterSkillPointSummary [data-skill-points]:has-text(\"1\")", "timeout": 15000, "label": "skill-point-refunded-individual" },
    { "action": "waitForSelector", "selector": "#characterSkillPointSummary [data-skill-gold]:has-text(\"450 G\")", "timeout": 15000, "label": "gold-consumed-individual" },
    { "action": "clickSelector", "selector": "[data-acquire-passive=\"PAS-0001\"]", "timeout": 15000, "label": "reacquire-passive" },
    { "action": "clickSelector", "selector": "#characterRespecAll", "timeout": 15000, "label": "all-respec" },
    { "action": "waitForSelector", "selector": "#characterSkillPointSummary [data-skill-points]:has-text(\"1\")", "timeout": 15000, "label": "skill-point-refunded-all" },
    { "action": "waitForSelector", "selector": "#characterSkillPointSummary [data-skill-gold]:has-text(\"250 G\")", "timeout": 15000, "label": "gold-consumed-all" },
    { "action": "waitForSelector", "selector": "[data-acquire-passive=\"PAS-0001\"]", "timeout": 15000, "label": "passive-unowned-after-all-respec" },
    { "action": "dumpStorage", "name": "b931-public-after-respec" },
    { "action": "dumpPage", "name": "b931-public-after-respec-page" },
    { "action": "screenshot", "name": "b931-public-after-respec" }
  ]
}
