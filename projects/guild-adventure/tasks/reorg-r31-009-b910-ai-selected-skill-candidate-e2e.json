{
  "schemaVersion": 1,
  "name": "REORG R31-009 B910 Player AI selected Active Skill candidate E2E",
  "outputDir": "artifacts",
  "viewport": { "width": 390, "height": 844 },
  "dialogPolicy": "accept",
  "steps": [
    { "action": "goto", "url": "http://127.0.0.1:4173/game/", "waitUntil": "networkidle", "timeout": 60000, "label": "open-b910-candidate" },
    { "action": "waitForSelector", "selector": "#phase-title.active", "timeout": 20000, "label": "title-ready" },
    { "action": "assertText", "text": "GA-B486.241", "exact": false, "label": "candidate-build-b486-241" },
    { "action": "clickSelector", "selector": "#titleStart", "timeout": 20000, "label": "new-game" },
    { "action": "waitForSelector", "selector": "#phase-base.active", "timeout": 30000, "label": "new-game-reaches-base" },
    { "action": "clickSelector", "selector": "#developerModeBtn", "timeout": 15000, "label": "enable-developer-mode" },
    { "action": "clickSelector", "selector": "#baseMobileNav [data-base-tab=\"adventurer\"]", "timeout": 15000, "label": "open-adventurer-tab" },
    { "action": "waitForSelector", "selector": "#roster .adventurer-row:has-text(\"アルト\")", "timeout": 20000, "label": "alto-ready" },
    { "action": "clickSelector", "selector": "#roster .adventurer-row:has-text(\"アルト\")", "timeout": 15000, "label": "select-alto" },
    { "action": "clickSelector", "selector": "#openSkillPlaceholder", "timeout": 15000, "label": "open-skills" },
    { "action": "waitForText", "text": "アルトのSkill / Passive", "exact": true, "timeout": 15000, "label": "skill-view" },
    { "action": "clickSelector", "selector": "[data-assign-formal-skill=\"SKL-0001\"]", "timeout": 15000, "label": "assign-skl-0001" },
    { "action": "clickSelector", "selector": "[data-assign-formal-skill=\"SKL-0002\"]", "timeout": 15000, "label": "assign-skl-0002" },
    { "action": "clickSelector", "selector": "[data-select-skill=\"SKL-0001\"]", "timeout": 15000, "label": "select-skl-0001" },
    { "action": "assertSelector", "selector": "[data-select-skill=\"SKL-0001\"][data-selected=\"1\"]", "label": "skl-0001-selected" },
    { "action": "assertSelector", "selector": "[data-select-skill=\"SKL-0002\"][data-selected=\"0\"]", "label": "skl-0002-unselected" },
    { "action": "clickSelector", "selector": "[data-open-base-view=\"adventurer\"]", "timeout": 15000, "label": "back-adventurer-detail" },
    { "action": "clickSelector", "selector": "#openAiEditor", "timeout": 15000, "label": "open-ai-editor-selected-0001" },
    { "action": "waitForSelector", "selector": "#aiEditor[aria-hidden=\"false\"]", "timeout": 30000, "label": "ai-editor-open-0001" },
    { "action": "clickSelector", "selector": "#aiBoard .ai-formal-cell:not(.occupied)", "timeout": 15000, "label": "open-empty-cell-0001" },
    { "action": "waitForSelector", "selector": "#aiCandidateScreen.open", "timeout": 15000, "label": "candidate-screen-0001" },
    { "action": "clickSelector", "selector": "[data-ai-category=\"action\"]", "timeout": 15000, "label": "open-action-config-0001" },
    { "action": "waitForSelector", "selector": "#aiConfigScreen.open", "timeout": 15000, "label": "action-config-0001" },
    { "action": "assertSelector", "selector": "[data-ai-action-choice] option[value*=\"SKL-0001\"]", "label": "selected-skill-0001-is-ai-candidate" },
    { "action": "dumpPage", "name": "b910-ai-selected-0001" },
    { "action": "screenshot", "name": "b910-ai-selected-0001" },
    { "action": "clickSelector", "selector": "#aiEditorClose", "timeout": 15000, "label": "close-ai-editor-0001" },
    { "action": "waitForSelector", "selector": "#aiEditor[aria-hidden=\"true\"]", "timeout": 15000, "label": "ai-editor-closed-0001" },
    { "action": "clickSelector", "selector": "#openSkillPlaceholder", "timeout": 15000, "label": "reopen-skills" },
    { "action": "clickSelector", "selector": "[data-select-skill=\"SKL-0001\"]", "timeout": 15000, "label": "unselect-skl-0001" },
    { "action": "clickSelector", "selector": "[data-select-skill=\"SKL-0002\"]", "timeout": 15000, "label": "select-skl-0002" },
    { "action": "assertSelector", "selector": "[data-select-skill=\"SKL-0001\"][data-selected=\"0\"]", "label": "skl-0001-now-unselected" },
    { "action": "assertSelector", "selector": "[data-select-skill=\"SKL-0002\"][data-selected=\"1\"]", "label": "skl-0002-now-selected" },
    { "action": "clickSelector", "selector": "[data-open-base-view=\"adventurer\"]", "timeout": 15000, "label": "back-detail-after-swap" },
    { "action": "clickSelector", "selector": "#openAiEditor", "timeout": 15000, "label": "open-ai-editor-selected-0002" },
    { "action": "waitForSelector", "selector": "#aiEditor[aria-hidden=\"false\"]", "timeout": 30000, "label": "ai-editor-open-0002" },
    { "action": "clickSelector", "selector": "#aiBoard .ai-formal-cell:not(.occupied)", "timeout": 15000, "label": "open-empty-cell-0002" },
    { "action": "waitForSelector", "selector": "#aiCandidateScreen.open", "timeout": 15000, "label": "candidate-screen-0002" },
    { "action": "clickSelector", "selector": "[data-ai-category=\"action\"]", "timeout": 15000, "label": "open-action-config-0002" },
    { "action": "waitForSelector", "selector": "#aiConfigScreen.open", "timeout": 15000, "label": "action-config-0002" },
    { "action": "assertSelector", "selector": "[data-ai-action-choice] option[value*=\"SKL-0002\"]", "label": "selected-skill-0002-is-ai-candidate" },
    { "action": "dumpPage", "name": "b910-ai-selected-0002" },
    { "action": "screenshot", "name": "b910-ai-selected-0002" },
    { "action": "dumpStorage", "name": "b910-ai-selected-swap-storage" }
  ]
}
