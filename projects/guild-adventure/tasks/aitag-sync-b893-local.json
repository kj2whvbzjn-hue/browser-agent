{
  "schemaVersion": 1,
  "name": "B893 AITAG ledger sync through Studio Development Management",
  "outputDir": "artifacts",
  "viewport": { "width": 1440, "height": 1800 },
  "dialogPolicy": "accept",
  "steps": [
    { "action": "goto", "url": "https://kj2whvbzjn-hue.github.io/guild-adventure-studio/studio/?appv=893", "waitUntil": "networkidle", "timeout": 60000, "label": "open-b893" },
    { "action": "waitForText", "text": "Studio GKS-B893", "timeout": 20000, "label": "confirm-b893" },
    { "action": "clickText", "text": "開発管理を開く", "exact": true, "timeout": 15000, "label": "open-development" },
    { "action": "waitForSelector", "selector": "#developmentProjectListView:not(.hidden)", "timeout": 15000, "label": "wait-development-list" },
    { "action": "waitForSelector", "selector": "#developmentProjectCards .dev-phonebook-row:has-text(\"Player AI パーツTag基盤・段階接続\")", "timeout": 30000, "label": "wait-aitag-card" },
    { "action": "clickSelector", "selector": "#developmentProjectCards .dev-phonebook-row:has-text(\"Player AI パーツTag基盤・段階接続\")", "timeout": 15000, "label": "open-aitag" },
    { "action": "waitForSelector", "selector": "#developmentProjectDetailView:not(.hidden)", "timeout": 20000, "label": "wait-aitag-detail" },
    { "action": "waitForSelector", "selector": "#developmentCurrentProjectTitle:has-text(\"Player AI パーツTag基盤・段階接続\")", "timeout": 15000, "label": "confirm-aitag-open" },
    { "action": "clickRole", "role": "button", "name": "構成・作業", "exact": true, "timeout": 15000, "label": "open-architecture" },
    { "action": "waitForSelector", "selector": "#developmentPane-architecture:not(.hidden)", "timeout": 15000, "label": "wait-architecture" },
    { "action": "clickSelector", "selector": "[data-dax-action=\"select-node\"][data-id=\"ARCH-AITAG-ROOT\"]", "timeout": 15000, "label": "select-aitag-root" },
    { "action": "waitForSelector", "selector": "[data-dax-action=\"select-box\"][data-id=\"BOX-AITAG-003\"]", "timeout": 15000, "label": "wait-box-003" },
    { "action": "clickSelector", "selector": "[data-dax-action=\"select-box\"][data-id=\"BOX-AITAG-003\"]", "timeout": 15000, "label": "select-box-003" },
    { "action": "waitForSelector", "selector": "[data-dax-action=\"select-task\"][data-id=\"TASK-AITAG-029\"]", "timeout": 15000, "label": "wait-task-029" },
    { "action": "clickSelector", "selector": "[data-dax-action=\"select-task\"][data-id=\"TASK-AITAG-029\"]", "timeout": 15000, "label": "select-task-029" },
    { "action": "waitForSelector", "selector": "#daxTaskViewId:has-text(\"TASK-AITAG-029\")", "timeout": 10000, "label": "confirm-task-029" },
    { "action": "assertText", "text": "Todo", "label": "confirm-old-status" },
    { "action": "clickSelector", "selector": "[data-dax-action=\"edit-current-task\"]", "timeout": 10000, "label": "edit-task-029" },
    { "action": "assertValueSelector", "selector": "#daxTaskApprovalStatus", "value": "Pending", "label": "approval-must-remain-pending" },
    { "action": "selectSelector", "selector": "#daxTaskStatus", "value": "Doing", "label": "sync-status-doing" },
    { "action": "clickSelector", "selector": "[data-dax-action=\"save-task\"]", "timeout": 10000, "label": "save-task-local" },
    { "action": "wait", "ms": 500 },
    { "action": "waitForSelector", "selector": "#daxTaskViewStatus:has-text(\"Doing\")", "timeout": 10000, "label": "confirm-new-status" },
    { "action": "waitForSelector", "selector": "#daxTaskViewMeta:has-text(\"人間承認: Pending\")", "timeout": 10000, "label": "confirm-approval-not-forged" },
    { "action": "waitForSelector", "selector": "#developmentDirtyIndicator:not(.hidden)", "timeout": 10000, "label": "confirm-git-dirty" },
    { "action": "screenshot", "name": "aitag-task029-doing-local" },
    { "action": "clickSelector", "selector": "#devProjectSaveButton", "timeout": 10000, "label": "open-git-save" },
    { "action": "assertValueSelector", "selector": "#developmentEditSaveBranch", "value": "sub", "label": "confirm-write-branch" },
    { "action": "assertValueSelector", "selector": "#developmentEditSavePat", "value": "", "label": "confirm-pat-not-stored" },
    { "action": "dumpPage", "name": "aitag-sync-final" },
    { "action": "dumpStorage", "name": "aitag-sync-storage" },
    { "action": "screenshot", "name": "aitag-git-save-pat-boundary" }
  ]
}
