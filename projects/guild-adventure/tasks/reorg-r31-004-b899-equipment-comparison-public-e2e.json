{
  "schemaVersion": 1,
  "name": "REORG R31-004 equipment comparison public Game E2E B899",
  "outputDir": "artifacts",
  "viewport": { "width": 390, "height": 844 },
  "dialogPolicy": "accept",
  "steps": [
    { "action": "goto", "url": "https://kj2whvbzjn-hue.github.io/guild-adventure-studio/game/", "waitUntil": "networkidle", "timeout": 60000, "label": "open-public-game" },
    { "action": "waitForSelector", "selector": "#phase-title.active", "timeout": 20000, "label": "title-ready" },
    { "action": "assertText", "text": "GA-B486.230", "exact": false, "label": "public-build-b486-230" },
    { "action": "clickSelector", "selector": "#titleStart", "timeout": 20000, "label": "new-game" },
    { "action": "waitForSelector", "selector": "#phase-base.active", "timeout": 30000, "label": "new-game-reaches-base" },
    { "action": "clickSelector", "selector": "#baseMobileNav [data-base-tab=\"adventurer\"]", "timeout": 15000, "label": "open-adventurer-tab" },
    { "action": "waitForText", "text": "ロウ", "exact": true, "timeout": 20000, "label": "row-ready" },
    { "action": "clickText", "text": "ロウ", "exact": true, "timeout": 15000, "label": "select-row" },
    { "action": "waitForSelector", "selector": "#openEquipView", "timeout": 15000, "label": "row-detail-ready" },
    { "action": "clickSelector", "selector": "#openEquipView", "timeout": 15000, "label": "open-row-equipment" },
    { "action": "waitForText", "text": "ロウの装備", "exact": true, "timeout": 15000, "label": "row-equipment-ready" },
    { "action": "assertText", "text": "布の軽装頭", "exact": true, "label": "row-light-head-equipped" },
    { "action": "clickSelector", "selector": "[data-character-unequip=\"head\"]", "timeout": 15000, "label": "unequip-row-head" },
    { "action": "waitForText", "text": "布の軽装頭", "exact": true, "timeout": 15000, "label": "light-head-moved-to-inventory" },
    { "action": "clickSelector", "selector": "[data-open-base-view=\"adventurer\"]", "timeout": 15000, "label": "back-to-adventurer" },
    { "action": "waitForText", "text": "アルト", "exact": true, "timeout": 15000, "label": "alto-ready" },
    { "action": "clickText", "text": "アルト", "exact": true, "timeout": 15000, "label": "select-alto" },
    { "action": "waitForSelector", "selector": "#openEquipView", "timeout": 15000, "label": "alto-detail-ready" },
    { "action": "clickSelector", "selector": "#openEquipView", "timeout": 15000, "label": "open-alto-equipment" },
    { "action": "waitForText", "text": "アルトの装備", "exact": true, "timeout": 15000, "label": "alto-equipment-ready" },
    { "action": "assertText", "text": "木の重装頭", "exact": true, "label": "alto-heavy-head-equipped" },
    { "action": "waitForSelector", "selector": "[data-character-equip-target=\"0\"]", "timeout": 15000, "label": "inventory-equip-target-ready" },
    { "action": "selectSelector", "selector": "[data-character-equip-target=\"0\"]", "value": { "index": 1 }, "timeout": 15000, "label": "select-head-target" },
    { "action": "waitForText", "text": "頭 装備前後比較", "exact": true, "timeout": 15000, "label": "comparison-preview-visible" },
    { "action": "assertText", "text": "差 ", "exact": false, "label": "battle-value-delta-visible" },
    { "action": "assertText", "text": "所持品へ戻る: 木の重装頭", "exact": true, "label": "returned-equipment-visible" },
    { "action": "assertText", "text": "MODなし", "exact": true, "label": "modifier-summary-visible" },
    { "action": "dumpPage", "name": "r31-004-b899-equipment-preview" },
    { "action": "screenshot", "name": "r31-004-b899-equipment-preview" },
    { "action": "clickSelector", "selector": "[data-character-equip-commit=\"0\"]", "timeout": 15000, "label": "commit-equipment-swap" },
    { "action": "waitForText", "text": "布の軽装頭", "exact": true, "timeout": 15000, "label": "alto-light-head-equipped" },
    { "action": "assertText", "text": "木の重装頭", "exact": true, "label": "heavy-head-returned-to-inventory" },
    { "action": "dumpStorage", "name": "r31-004-b899-after-equipment-swap" },
    { "action": "dumpPage", "name": "r31-004-b899-after-equipment-swap-page" },
    { "action": "screenshot", "name": "r31-004-b899-after-equipment-swap" }
  ]
}
