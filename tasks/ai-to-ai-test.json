{
  "schemaVersion": 1,
  "label": "ai-to-ai-duckai-models",
  "outputDir": "artifacts",
  "steps": [
    {
      "action": "goto",
      "url": "https://duck.ai/",
      "waitUntil": "domcontentloaded",
      "timeout": 30000
    },
    {
      "action": "wait",
      "ms": 3000
    },
    {
      "action": "clickRole",
      "role": "button",
      "name": "5.6 Luna",
      "exact": true,
      "timeout": 10000
    },
    {
      "action": "wait",
      "ms": 1000
    },
    {
      "action": "dumpPage",
      "name": "duckai-models"
    },
    {
      "action": "screenshot",
      "name": "duckai-models"
    }
  ]
}
