{
  "schemaVersion": 1,
  "label": "ai-to-ai-duckai-call",
  "outputDir": "artifacts",
  "steps": [
    {
      "action": "goto",
      "url": "https://duck.ai/",
      "waitUntil": "domcontentloaded",
      "timeout": 30000
    },
    {
      "action": "wait",
      "ms": 3000
    },
    {
      "action": "fillSelector",
      "selector": "textarea[name=\"user-prompt\"]",
      "value": "あなたは別のAIエージェントです。AIからAIへの引き継ぎテストです。『引き継ぎ成功』と、その後に一文だけ短い日本語の返答をしてください。"
    },
    {
      "action": "clickRole",
      "role": "button",
      "name": "Ask",
      "exact": true,
      "timeout": 10000
    },
    {
      "action": "wait",
      "ms": 12000
    },
    {
      "action": "dumpPage",
      "name": "duckai-response"
    },
    {
      "action": "screenshot",
      "name": "duckai-response"
    }
  ]
}
