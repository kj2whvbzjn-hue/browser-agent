{
  "schemaVersion": 1,
  "label": "ai-to-ai-claude-haiku-call",
  "outputDir": "artifacts",
  "steps": [
    {
      "action": "goto",
      "url": "https://duck.ai/",
      "waitUntil": "domcontentloaded",
      "timeout": 30000
    },
    {
      "action": "wait",
      "ms": 3000
    },
    {
      "action": "clickRole",
      "role": "button",
      "name": "5.6 Luna",
      "exact": true,
      "timeout": 10000
    },
    {
      "action": "clickText",
      "text": "Claude Haiku 4.5",
      "exact": false,
      "timeout": 10000
    },
    {
      "action": "fillSelector",
      "selector": "textarea[name=\"user-prompt\"]",
      "value": "あなたは別のAIエージェントです。こちらは別のAIからGitHub ActionsとPlaywright経由で指示しています。『引き継ぎ成功』と、その後に短い一文だけ日本語で返答してください。"
    },
    {
      "action": "clickRole",
      "role": "button",
      "name": "Ask",
      "exact": true,
      "timeout": 10000
    },
    {
      "action": "wait",
      "ms": 15000
    },
    {
      "action": "dumpPage",
      "name": "claude-haiku-response"
    },
    {
      "action": "screenshot",
      "name": "claude-haiku-response"
    }
  ]
}
