{
  "outputDir": "artifacts",
  "viewport": { "width": 1440, "height": 900 },
  "dialogPolicy": "accept",
  "steps": [
    {
      "action": "goto",
      "url": "https://kj2whvbzjn-hue.github.io/guild-adventure-studio/game/",
      "waitUntil": "domcontentloaded",
      "label": "open-game",
      "screenshotAfter": true
    },
    {
      "action": "clickRole",
      "role": "button",
      "name": "はじめから",
      "label": "start-new-game",
      "screenshotAfter": true
    },
    {
      "action": "waitForText",
      "text": "遠征準備",
      "label": "wait-base-screen",
      "timeout": 20000
    },
    {
      "action": "checkSelector",
      "selector": "input[name='quest'][value='QST-0006']",
      "label": "select-story-battle-override",
      "screenshotAfter": true
    },
    {
      "action": "clickRole",
      "role": "button",
      "name": "冒険へ出発",
      "label": "depart",
      "timeout": 15000,
      "screenshotAfter": true
    },
    {
      "action": "wait",
      "ms": 1500,
      "label": "settle-after-depart"
    },
    {
      "action": "dumpPage",
      "name": "after-depart-state"
    },
    {
      "action": "screenshot",
      "name": "after-depart"
    }
  ]
}
