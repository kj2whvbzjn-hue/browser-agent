{
  "outputDir": "artifacts",
  "viewport": { "width": 1440, "height": 900 },
  "dialogPolicy": "accept",
  "steps": [
    { "action": "goto", "url": "https://kj2whvbzjn-hue.github.io/guild-adventure-studio/game/", "waitUntil": "domcontentloaded", "label": "open-game" },
    { "action": "clickRole", "role": "button", "name": "はじめから", "label": "start-new-game" },
    { "action": "waitForText", "text": "遠征準備", "label": "wait-base-screen", "timeout": 20000 },
    { "action": "checkSelector", "selector": "input[name='quest'][value='QST-0006']", "label": "select-story-battle-override" },
    { "action": "clickRole", "role": "button", "name": "冒険へ出発", "label": "depart", "timeout": 15000 },
    { "action": "wait", "ms": 34000, "label": "wait-for-quest-completion" },
    { "action": "waitForSelector", "selector": "#adventureReturn:not([disabled])", "label": "wait-return-enabled", "timeout": 10000 },
    { "action": "clickSelector", "selector": "#adventureReturn", "label": "confirm-return" },
    { "action": "wait", "ms": 800, "label": "settle-result-screen" },
    { "action": "waitForSelector", "selector": "#adventureReturnHome", "label": "wait-return-home", "timeout": 10000 },
    { "action": "clickSelector", "selector": "#adventureReturnHome", "label": "return-to-base", "screenshotAfter": true },
    { "action": "wait", "ms": 1000, "label": "settle-base" },
    { "action": "dumpPage", "name": "final-base-state" },
    { "action": "screenshot", "name": "final-base" }
  ]
}
